# an example runtime config file
host_addr 10.10.30.1
host_netmask 255.255.255.0
host_gateway 0.0.0.0
host_mtu 9000
static_arp 10.10.30.11 7c:c2:55:be:ca:c7
static_arp 10.10.30.10 EC:0D:9A:6E:2B:F8
runtime_cxl_path /dev/dax2.0
runtime_iok_socket_index 2
runtime_pmyiok_index 0
# runtime_bak_pmyiok_index 1
# runtime_cores 52-59
runtime_kthreads 12
runtime_guaranteed_kthreads 12
runtime_spinning_kthreads 12
runtime_priority lc
